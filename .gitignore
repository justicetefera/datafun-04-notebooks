# ============================================================
# .gitignore (Keep unnecessary files out of the repository)
# ============================================================

# REQ.UNIVERSAL: All professional GitHub project repositories MUST include .gitignore.
# WHY: Prevent committing generated artifacts, local state, secrets, and OS-specific files.

# === Universal (all projects, all languages) ===

# Logs
# *.log
# logs/
PRIVATE_NOTES.md
PRIVATE-NOTES.md

# Temporary files
*.swo
*.swp
*.tmp
*~

# === VS Code ===
.vscode/
!.vscode/extensions.json
!.vscode/settings.json

# === OS-specific files ===
.AppleDouble
.DS_Store
.LSOverride
Icon\r
._*
.Spotlight-V100/
.Trashes
desktop.ini
ehthumbs.db
Thumbs.db

# === Editors / IDEs ===
*.code-workspace
.idea/

# === Environment variables ===
.env
.env.*
*.env

# === Documentation build output ===
site/

# === Generic caches ===
.cache/

# === Python ===
.venv/
venv/

# REQ.PYTHON: Do NOT git ignore uv.lock. Commit it and use it in CI/CD pipelines.

**/src/**/_version.py

__pycache__/
*.pyc
*.pyd
*.pyo

.eggs/
build/
dist/
*.egg
*.egg-info/
*.whl

.coverage
.coverage.*
.mypy_cache/
.pytest_cache/
.pytype/
.ruff_cache/
.tox/

.ipynb_checkpoints/
